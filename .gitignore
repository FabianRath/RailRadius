# Large local data: GTFS zips, multi-GB caches (see docs/decisions.md)
data/
*-cache.json
*.hprof
dump.*

# Local settings with secrets, e.g. feed credentials (Spring Boot reads config/ in the working directory)
/backend/config/

# Build output
target/
!**/src/main/**/target/
!**/src/test/**/target/
.mvn/wrapper/maven-wrapper.jar

# Claude Code: personal settings stay local, shared settings/skills are committed
.claude/settings.local.json
.claude/launch.json

# IDEs
.idea/
*.iml
*.iws
*.ipr
.vscode/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/
.apt_generated/
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# OS
Thumbs.db
.DS_Store

# Playwright MCP screenshots and logs
.playwright-mcp/

# Personal manual test notes
MANUAL_TEST.md

# llm-council skill output
council-report-*.html
council-transcript-*.md
