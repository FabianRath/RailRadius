{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(mvn -q -f backend/pom.xml *)",
      "Bash(mvn -f backend/pom.xml *)",
      "Bash(scripts/api.sh health)",
      "Bash(scripts/api.sh stats)",
      "Bash(scripts/api.sh search *)",
      "Bash(scripts/api.sh station *)",
      "Bash(scripts/api.sh reach *)",
      "Bash(scripts/api.sh cache-stats)",
      "Bash(scripts/api.sh gtfs-stats)",
      "Bash(scripts/api.sh debug-status)",
      "Bash(curl -s localhost:8080/api/*)",
      "Bash(curl -s http://localhost:8080/api/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(ls *)",
      "Bash(tail *)",
      "Bash(unzip -l *)"
    ],
    "deny": [
      "Read(**/target/**)",
      "Bash(git push --force*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "grep -qiE \"backend[/\\\\\\\\]+data[/\\\\\\\\]\" && { echo \"backend/data/ holds multi-GB files: peek with capped Bash commands instead (see CLAUDE.md)\" >&2; exit 2; } || exit 0",
            "statusMessage": "Checking backend/data guard"
          }
        ]
      }
    ]
  }
}